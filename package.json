{
  "name": "klozbuy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @klozbuy/db generate",
    "db:migrate": "pnpm --filter @klozbuy/db migrate",
    "db:setup:local": "pnpm --filter @klozbuy/db create-database && pnpm --filter @klozbuy/db migrate",
    "dev:api": "pnpm --filter @klozbuy/api dev:local",
    "dev:web": "pnpm --filter @klozbuy/app web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@klozbuy/config": "workspace:*",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
