{
  "name": "@klozbuy/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web && cp worker/index.js dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview:web": "wrangler dev --env=\"\""
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.7",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@klozbuy/api-client": "workspace:*",
    "@klozbuy/contracts": "workspace:*",
    "@klozbuy/shared": "workspace:*",
    "@klozbuy/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "better-auth": "^1.7.7",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-server": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@klozbuy/config": "workspace:*",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
